<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WorklogCalendar.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configuración"
    PrimaryButtonText="Guardar"
    SecondaryButtonText="Cancelar"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">700</x:Double>
    </ContentDialog.Resources>
    <Pivot x:Name="Tabs" Width="700">
        <PivotItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="4,8,4,16">
                    <TextBlock Text="Modo de vista" Opacity="0.7" />
                    <RadioButtons x:Name="ViewModeChooser" SelectedIndex="0">
                        <x:String>9h  (09:00 – 18:00)</x:String>
                        <x:String>24h (00:00 – 24:00)</x:String>
                    </RadioButtons>

                    <TextBlock Text="Fuente por defecto" Opacity="0.7" Margin="0,8,0,0" />
                    <RadioButtons x:Name="SourceChooser" SelectedIndex="0">
                        <x:String>Jira</x:String>
                        <x:String>Jira / Clockify</x:String>
                        <x:String>Clockify</x:String>
                    </RadioButtons>

                    <TextBlock Text="Primer día de la semana" Opacity="0.7" Margin="0,8,0,0" />
                    <RadioButtons x:Name="FirstDayChooser" SelectedIndex="0">
                        <x:String>Domingo</x:String>
                        <x:String>Lunes</x:String>
                    </RadioButtons>

                    <Grid ColumnSpacing="8" RowSpacing="6" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <NumberBox x:Name="DailyTarget" Header="Objetivo diario (horas)"
                                   Minimum="0" Maximum="24" SmallChange="0.5"
                                   SpinButtonPlacementMode="Inline"
                                   Grid.Row="0" Grid.Column="0" />
                        <NumberBox x:Name="WinWidth" Header="Ancho ventana (px)" Minimum="600" Maximum="3840"
                                   SpinButtonPlacementMode="Inline"
                                   Grid.Row="0" Grid.Column="1" />
                        <NumberBox x:Name="WinHeight" Header="Alto ventana (px)" Minimum="400" Maximum="2160"
                                   SpinButtonPlacementMode="Inline"
                                   Grid.Row="1" Grid.Column="0" />
                        <CheckBox x:Name="AlwaysOnTop" Content="Mantener sobre otras ventanas"
                                  Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Modal size (Jira / Clockify edit dialogs). -->
                    <Grid ColumnSpacing="8" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="ModalW" Header="Ancho modal (px)"
                                   Minimum="360" Maximum="2000"
                                   SpinButtonPlacementMode="Inline" Grid.Column="0" />
                        <NumberBox x:Name="ModalH" Header="Alto modal (px)"
                                   Minimum="280" Maximum="1500"
                                   SpinButtonPlacementMode="Inline" Grid.Column="1" />
                    </Grid>

                    <CheckBox x:Name="ShowGauges" Content="Mostrar panel inferior (anillos Sprint/Horas ↔ tabla subtareas ↔ heatmap mensual)"
                              Margin="0,8,0,0" />

                    <!-- Subtask table -->
                    <TextBlock Text="Tabla de subtareas" FontWeight="SemiBold"
                               Margin="0,12,0,4" Opacity="0.85" />
                    <CheckBox x:Name="ShowSubtaskTable"
                              Content="Mostrar la tabla de subtareas como vista intermedia del panel inferior" />
                    <CheckBox x:Name="SubtaskShowParent"
                              Content="Mostrar columna 'Padre' (issue padre + tooltip con título)" />
                    <TextBox x:Name="SubtaskJql" Header="JQL para la tabla de subtareas"
                             AcceptsReturn="True" TextWrapping="Wrap" />

                    <!-- Sprint (experimental) -->
                    <TextBlock Text="Sprint (experimental)" FontWeight="SemiBold"
                               Margin="0,16,0,4" Opacity="0.85" />
                    <CheckBox x:Name="ShowRingsView"
                              Content="Ofrecer los anillos Sprint/Horas como vista del panel inferior" />
                    <TextBlock Text="Cómo descubrir el sprint activo del usuario."
                               Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                    <RadioButtons x:Name="SprintStrategyChooser" SelectedIndex="0">
                        <x:String>Subtask + customfield (recomendado para setups con subtareas)</x:String>
                        <x:String>Agile board (requiere Board ID)</x:String>
                        <x:String>Assignee JQL (sprint in openSprints() AND assignee = currentUser())</x:String>
                    </RadioButtons>
                    <TextBox x:Name="SprintField" Header="Sprint custom field id"
                             PlaceholderText="customfield_10020" />
                    <NumberBox x:Name="SprintBoardId" Header="Board ID (solo para 'Agile board')"
                               Minimum="0" Maximum="9999999" SpinButtonPlacementMode="Inline" />
                    <TextBlock Text="Cómo calcular las horas Disponibles."
                               Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <RadioButtons x:Name="RemainingChooser" SelectedIndex="0">
                        <x:String>API (Jira's remainingEstimateSeconds)</x:String>
                        <x:String>Calculado (originalEstimate - timeSpent)</x:String>
                    </RadioButtons>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <PivotItem Header="Jira">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Padding="4,8,4,16">
                    <TextBox x:Name="JiraSite" Header="Site URL"
                             PlaceholderText="https://your-company.atlassian.net" />
                    <TextBox x:Name="JiraEmail" Header="Email" />
                    <PasswordBox x:Name="JiraToken" Header="API token (NO tu password)"
                                 PasswordRevealMode="Peek" />
                    <TextBox x:Name="JiraJql" Header="JQL del picker (nuevos worklogs)"
                             AcceptsReturn="True" TextWrapping="Wrap" />
                    <NumberBox x:Name="JiraIssueMax" Header="Máx. issues en el picker"
                               Minimum="10" Maximum="200" SpinButtonPlacementMode="Inline" />
                    <CheckBox x:Name="JiraShowSummary" Content="Mostrar el título del issue además de la key" />
                    <CheckBox x:Name="JiraDebug" Content="Loguear cada request a Debug Output" />

                    <TextBox x:Name="Jira1Color" Header="Color de los bloques (hex #rrggbb)"
                             PlaceholderText="#9b91e6" />

                    <!-- Second instance -->
                    <TextBlock Text="Segunda instancia de Jira" FontWeight="SemiBold"
                               Margin="0,16,0,4" Opacity="0.85" />
                    <TextBlock Text="Muestra los worklogs de un segundo sitio Jira en la misma región del calendario, distinguidos por color. Se pueden solapar."
                               Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                    <CheckBox x:Name="Jira2Enabled" Content="Habilitar la segunda instancia" />
                    <TextBox x:Name="Jira2Site" Header="Site URL"
                             PlaceholderText="https://otra-empresa.atlassian.net" />
                    <TextBox x:Name="Jira2Email" Header="Email" />
                    <PasswordBox x:Name="Jira2Token" Header="API token" PasswordRevealMode="Peek" />
                    <TextBox x:Name="Jira2Color" Header="Color de los bloques (hex #rrggbb)"
                             PlaceholderText="#26a69a" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <PivotItem Header="Clockify">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Padding="4,8,4,16">
                    <PasswordBox x:Name="ClockifyKey" Header="API key (Profile → Settings → API)"
                                 PasswordRevealMode="Peek" />
                    <TextBox x:Name="ClockifyWorkspace" Header="Workspace ID (opcional, se autoresuelve)" />
                    <TextBox x:Name="ClockifyDefaultProject" Header="Proyecto por defecto (ID) — preseleccionado al crear una entrada" />
                    <CheckBox x:Name="ClockifyBillable" Content="Marcar como facturable por defecto" />
                    <CheckBox x:Name="ClockifyDebug" Content="Loguear cada request a Debug Output" />

                    <!-- Per-instance sync mapping -->
                    <TextBlock Text="Destino del sync Jira → Clockify" FontWeight="SemiBold"
                               Margin="0,16,0,4" Opacity="0.85" />
                    <TextBlock Text="Cada instancia de Jira escribe en su propio proyecto de Clockify, así el dedup nunca cruza entre instancias. Vacío = sin proyecto."
                               Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                    <ComboBox x:Name="Jira1ProjectCombo" Header="Proyecto para Jira 1"
                              DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="Jira2ProjectCombo" Header="Proyecto para Jira 2"
                              DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                    <Button x:Name="LoadProjectsBtn" Content="Cargar proyectos de Clockify" />
                    <TextBlock x:Name="ProjectsStatus" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <PivotItem Header="Google">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Padding="4,8,4,16">
                    <TextBlock Text="Muestra tus eventos de Google Calendar como bloques de fondo (solo lectura), para poder cargar horas «encima» de una reunión."
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    <CheckBox x:Name="GoogleEnabled" Content="Mostrar eventos de Google Calendar" />

                    <TextBlock Text="1 · Credenciales OAuth" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11"
                               Text="Creá un cliente OAuth gratuito en Google Cloud Console del tipo «TV y dispositivos de entrada limitada», habilitá la Google Calendar API y pegá acá el Client ID y el secret. Solo se pide el scope calendar.readonly." />
                    <TextBox x:Name="GoogleClientId" Header="Client ID" />
                    <PasswordBox x:Name="GoogleClientSecret" Header="Client secret" PasswordRevealMode="Peek" />

                    <TextBlock Text="2 · Autorización" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="GoogleAuthBtn" Content="Autorizar…" />
                        <Button x:Name="GoogleAuthCancelBtn" Content="Cancelar" IsEnabled="False" />
                    </StackPanel>
                    <Border x:Name="GoogleCodeBox" Visibility="Collapsed"
                            Background="#22FFFFFF" CornerRadius="4" Padding="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ingresá este código en la página de Google:" FontSize="11" Opacity="0.8" />
                            <TextBlock x:Name="GoogleUserCode" FontSize="22" FontWeight="Bold"
                                       FontFamily="Consolas" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="GoogleVerifUrl" FontSize="11" Opacity="0.8"
                                       IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="GoogleAuthStatus" FontSize="11" TextWrapping="Wrap" Opacity="0.85" />
                    <PasswordBox x:Name="GoogleRefreshToken" Header="Refresh token (se completa solo)"
                                 PasswordRevealMode="Peek" />

                    <TextBlock Text="3 · Calendarios (hasta 3)" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <Button x:Name="GoogleLoadCalsBtn" Content="Cargar calendarios" />
                    <TextBlock x:Name="GoogleCalStatus" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />

                    <Grid ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="GoogleCal1" Header="Calendario 1" DisplayMemberPath="Label"
                                  HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="0" />
                        <TextBox x:Name="GoogleCal1Color" Header="Color" PlaceholderText="#e74c3c"
                                 Grid.Row="0" Grid.Column="1" />
                        <ComboBox x:Name="GoogleCal2" Header="Calendario 2" DisplayMemberPath="Label"
                                  HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="0" />
                        <TextBox x:Name="GoogleCal2Color" Header="Color" PlaceholderText="#3498db"
                                 Grid.Row="1" Grid.Column="1" />
                        <ComboBox x:Name="GoogleCal3" Header="Calendario 3" DisplayMemberPath="Label"
                                  HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="0" />
                        <TextBox x:Name="GoogleCal3Color" Header="Color" PlaceholderText="#9b59b6"
                                 Grid.Row="2" Grid.Column="1" />
                    </Grid>
                    <CheckBox x:Name="GoogleDebug" Content="Loguear cada request a worklog.log" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</ContentDialog>
