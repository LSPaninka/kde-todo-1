<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WorklogCalendar.Views.SubtaskDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Abrir en Jira"
    CloseButtonText="Cerrar"
    DefaultButton="Close">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1200</x:Double>
    </ContentDialog.Resources>
    <Grid x:Name="BodyGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header (key + summary + busy) -->
            <RowDefinition Height="Auto" /> <!-- Status badge -->
            <RowDefinition Height="Auto" /> <!-- Labelled grid -->
            <RowDefinition Height="Auto" /> <!-- Estimates -->
            <RowDefinition Height="Auto" /> <!-- "Descripción" label -->
            <RowDefinition Height="*"   /> <!-- Description -->
            <RowDefinition Height="Auto" /> <!-- Created/Updated -->
            <RowDefinition Height="Auto" /> <!-- Error -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="KeyText" Grid.Column="0" FontFamily="Consolas" FontWeight="Bold" />
            <TextBlock x:Name="SummaryText" Grid.Column="1" FontWeight="Bold" TextWrapping="Wrap" />
            <ProgressRing x:Name="Busy" Grid.Column="2" IsActive="False" Width="18" Height="18" />
        </Grid>

        <!-- Status badge -->
        <Border x:Name="StatusBadge" Grid.Row="1" CornerRadius="10"
                Height="22" Padding="10,0,10,0" HorizontalAlignment="Left" Margin="0,8,0,4"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText" FontSize="11" FontWeight="Bold"
                       Foreground="#1A1A1A" VerticalAlignment="Center" />
        </Border>

        <!-- Labelled grid -->
        <Grid Grid.Row="2" RowSpacing="3" ColumnSpacing="20" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Tipo de actividad:" Opacity="0.6" Grid.Row="0" Grid.Column="0" />
            <TextBlock x:Name="TypeText" FontWeight="Bold" Grid.Row="0" Grid.Column="1" />

            <TextBlock Text="Prioridad:" Opacity="0.6" Grid.Row="1" Grid.Column="0" />
            <TextBlock x:Name="PriorityText" Grid.Row="1" Grid.Column="1" />

            <TextBlock x:Name="ParentLabel" Text="Padre:" Opacity="0.6" Grid.Row="2" Grid.Column="0" />
            <TextBlock x:Name="ParentText" FontWeight="Bold" Grid.Row="2" Grid.Column="1"
                       TextWrapping="Wrap" />

            <TextBlock Text="Asignado a:" Opacity="0.6" Grid.Row="3" Grid.Column="0" />
            <TextBlock x:Name="AssigneeText" Grid.Row="3" Grid.Column="1" />
        </Grid>

        <!-- Estimates -->
        <Grid Grid.Row="3" ColumnSpacing="24" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="0">
                <TextBlock Text="Original" FontSize="11" Opacity="0.6" />
                <TextBlock x:Name="OrigText" FontFamily="Consolas" FontWeight="Bold" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="0">
                <TextBlock Text="Quemadas" FontSize="11" Opacity="0.6" />
                <TextBlock x:Name="SpentText" FontFamily="Consolas" FontWeight="Bold" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="0">
                <TextBlock Text="Disponible" FontSize="11" Opacity="0.6" />
                <TextBlock x:Name="RemText" FontFamily="Consolas" FontWeight="Bold" />
            </StackPanel>
        </Grid>

        <!-- Description -->
        <TextBlock Text="Descripción" Grid.Row="4" Opacity="0.7" Margin="0,4,0,4" />
        <TextBox x:Name="DescBox" Grid.Row="5" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" MinHeight="100" />

        <!-- Created / Updated -->
        <TextBlock x:Name="StampsText" Grid.Row="6" Opacity="0.55" FontSize="11"
                   Margin="0,8,0,0" />

        <!-- Error -->
        <TextBlock x:Name="ErrorText" Grid.Row="7" TextWrapping="Wrap"
                   Foreground="#E74C3C" Visibility="Collapsed" Margin="0,4,0,0" />
    </Grid>
</ContentDialog>
